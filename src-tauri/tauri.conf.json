{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dasharr",
  "version": "0.2.0",
  "identifier": "com.vitorsinc.dasharr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Dasharr", "width": 1360, "height": 860, "minWidth": 980, "minHeight": 640, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http://dasharr-img.localhost dasharr-img:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
